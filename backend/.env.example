# ============================================================================
# ⚠️  SECURITY WARNING
# ============================================================================
# NEVER commit the .env file to version control
# NEVER share your API keys publicly
# Revoke and regenerate keys immediately if exposed
# ============================================================================

# ============================================================================
# API KEYS
# ============================================================================

# Google Gemini API Key (Required for story generation)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here


# ============================================================================
# IMAGE GENERATION CONFIGURATION
# ============================================================================

# Primary image generation provider
# Options: "placeholder", "imagen", "dalle", "stability"
# Default: "placeholder" (free, no API key needed)
IMAGE_PROVIDER=placeholder

# Fallback providers (comma-separated, in order of preference)
# Will try these if primary fails
IMAGE_FALLBACK_PROVIDERS=placeholder

# Enable image caching (reduces API costs)
IMAGE_CACHE_ENABLED=true


# ============================================================================
# IMAGE GENERATION API KEYS (Optional - only needed for chosen provider)
# ============================================================================

# Google Imagen 3 API Key
# Same as Gemini key if using Google AI Studio
# IMAGEN_API_KEY=your_imagen_api_key_here

# OpenAI API Key (for DALL-E 3)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Stability AI API Key (for Stable Diffusion)
# Get from: https://platform.stability.ai/account/keys
# STABILITY_API_KEY=your_stability_api_key_here
